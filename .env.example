# For local development with a local MongoDB instance:
# DATABASE_URL="mongodb://localhost:27017/volunteer_planner"
#
# For MongoDB Atlas, use the connection string from your Atlas cluster dashboard.
# Replace <username>, <password>, and <cluster-url> with your actual values.
# The password must be URL-encoded if it contains special characters
# (e.g. '@' -> '%40', '#' -> '%23').
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority"
JWT_SECRET="change-me-to-a-long-random-secret"
