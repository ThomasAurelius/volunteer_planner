# Copy this file to .env and fill in your values before running the app.
#
# For local development with a local MongoDB instance:
# DATABASE_URL="mongodb://localhost:27017/volunteer_planner"
#
# For MongoDB Atlas:
# 1. Log in to https://cloud.mongodb.com and open your cluster.
# 2. Click "Connect" > "Drivers" and copy the connection string.
# 3. Replace <password> with your Atlas database user's password.
#    If the password contains special characters (e.g. @, #, $), they must be
#    URL-encoded: @ -> %40, # -> %23, $ -> %24, etc.
# 4. Replace <dbname> with your database name (e.g. volunteer_planner).
# 5. Make sure the IP that runs this app is allowed in Atlas > Network Access.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority"

# Generate a long random secret for JWT signing, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
